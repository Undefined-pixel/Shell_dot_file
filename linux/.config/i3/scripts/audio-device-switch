#!/usr/bin/env bash

# audio-device-switch — cycle to the next available audio sink.
# Uses wpctl (so WirePlumber doesn't immediately route back) and skips
# sinks whose active port is "not available" (e.g. unplugged HDMI).

set -euo pipefail

mapfile -t entries < <(
  pactl --format=json list sinks | jq -r '
    .[] as $s
    | $s.ports[]
    | select(.name == $s.active_port and .availability != "not available")
    | "\($s.properties["object.id"])\t\($s.name)\t\($s.description)"
  '
)

if [ ${#entries[@]} -eq 0 ]; then
  notify-send -i audio-volume-muted "Audio switch" "No available sinks found"
  exit 0
fi

current=$(pactl get-default-sink)

current_idx=-1
for i in "${!entries[@]}"; do
  IFS=$'\t' read -r _ name _ <<<"${entries[$i]}"
  if [[ "$name" == "$current" ]]; then
    current_idx=$i
    break
  fi
done

next_idx=$(( (current_idx + 1) % ${#entries[@]} ))
IFS=$'\t' read -r next_id next_name next_desc <<<"${entries[$next_idx]}"

wpctl set-default "$next_id"

for input in $(pactl list short sink-inputs | awk '{print $1}'); do
  pactl move-sink-input "$input" "$next_name" || true
done

notify-send -i audio-volume-high "Sound output switched to:" "$next_desc"
