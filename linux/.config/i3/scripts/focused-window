#!/bin/bash

get_title() {
    local wid
    wid=$(xprop -root _NET_ACTIVE_WINDOW 2>/dev/null | awk '{print $5}')
    if [ -z "$wid" ] || [ "$wid" = "0x0" ]; then
        echo ""
        return
    fi
    xprop -id "$wid" _NET_WM_NAME 2>/dev/null \
        | sed 's/_NET_WM_NAME(UTF8_STRING) = "//;s/"$//' \
        | LANG=C sed 's/[^[:print:]]//g' \
        | cut -c1-50
}

# Print initial title
get_title

# Subscribe to window and workspace events
i3-msg -t subscribe -m '["window","workspace"]' 2>/dev/null | while read -r _; do
    get_title
done
