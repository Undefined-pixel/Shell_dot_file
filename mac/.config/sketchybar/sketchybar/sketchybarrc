# sketchybar config — i3bar style with aerospace
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=22 \
  radius=0 \
  color=0xff2b2b2b \
  border_width=0 \
  shadow=off \
  margin=0 \
  corner_radius=0 \
  topmost=off \
  sticky=on \
  font_smoothing=off

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:Regular:11.0"
  label.font="Hack Nerd Font:Regular:11.0"
  icon.color=0xffaaaaaa
  label.color=0xffaaaaaa
  icon.padding_left=6
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=6
  updates=on
)
sketchybar --default "${default[@]}"

##### Workspaces #####
sketchybar --add event aerospace_workspace_change

for monitor in $(aerospace list-monitors --format "%{monitor-appkit-nsscreen-screens-id}"); do
  for sid in $(aerospace list-workspaces --monitor "$monitor"); do
    display_id="1"
    if [ "$sid" -ge 8 ] && [ "$sid" -le 10 ]; then
      display_id="2"
    fi

    sketchybar --add item space.$sid left \
      --set space.$sid \
        display="$display_id" \
        drawing=on \
        background.color=0x00000000 \
        background.corner_radius=0 \
        background.drawing=off \
        background.border_color=0x00000000 \
        background.border_width=0 \
        background.height=22 \
        icon="$sid" \
        icon.font="Hack Nerd Font:Regular:11.0" \
        icon.color=0xffaaaaaa \
        icon.padding_left=8 \
        icon.padding_right=4 \
        label="" \
        label.drawing=on \
        label.font="sketchybar-app-font:Regular:13.0" \
        label.color=0xffaaaaaa \
        label.padding_left=0 \
        label.padding_right=8 \
        label.y_offset=-1 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid" \
      --subscribe space.$sid aerospace_workspace_change
  done
done

##### App-Icons beim Start laden #####
for monitor in $(aerospace list-monitors); do
  for sid in $(aerospace list-workspaces --monitor "$monitor" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set space.$sid drawing=on

    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $($CONFIG_DIR/plugins/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi

    sketchybar --set space.$sid label="$icon_strip"
  done
done

##### Front App #####
source "$ITEM_DIR/front_app.sh"

##### Rechte Items #####
sketchybar \
  --add item battery right \
  --set battery \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=0 \
  --subscribe battery system_woke power_source_change \
  \
  --add item volume right \
  --set volume \
    script="$PLUGIN_DIR/volume.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=0 \
  --subscribe volume volume_change \
  \
  --add item clock right \
  --set clock \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=6

sketchybar --update
