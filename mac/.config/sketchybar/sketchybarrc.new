#!/bin/bash
# sketchybar config with correct aerospace workspace display mapping

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

source "$CONFIG_DIR/colors.sh"

##### Bar Appearance #####
sketchybar --bar \
  position=top \
  height=22 \
  radius=0 \
  color=0xff2b2b2b \
  border_width=0 \
  shadow=off \
  margin=0 \
  corner_radius=0 \
  topmost=off \
  sticky=on \
  font_smoothing=off

##### Defaults #####
default=(
  padding_left=0
  padding_right=0
  icon.font="Hack Nerd Font:Regular:11.0"
  label.font="Hack Nerd Font:Regular:11.0"
  icon.color=0xffaaaaaa
  label.color=0xffaaaaaa
  icon.padding_left=6
  icon.padding_right=2
  label.padding_left=2
  label.padding_right=6
  updates=on
)
sketchybar --default "${default[@]}"

##### Workspaces #####
sketchybar --add event aerospace_workspace_change

# CORRECT MAPPING:
# Workspace 1,2,3,4 (Monitor 1: DELL P2421 2) → sketchybar arrangement-id 1
# Workspace 11 (Monitor 2: Built-in) → sketchybar arrangement-id 3
# Workspace 0 (Monitor 3: DELL P2421 1) → sketchybar arrangement-id 2

declare -i ws_idx=0
for sid in 0 1 2 3 4 11; do
    # Determine display for this workspace
    case $sid in
        0)  DISPLAY=2 ;;   # arrangement-id 2 = Monitor 3
        1|2|3|4) DISPLAY=1 ;; # arrangement-id 1 = Monitor 1
        11) DISPLAY=3 ;;   # arrangement-id 3 = Monitor 2
        *) DISPLAY=1 ;;    # fallback
    esac

    # Add separator (not on first workspace)
    if [ "$ws_idx" -gt 0 ]; then
        sketchybar --add item sep.$sid left --display="$DISPLAY" \
          --set sep.$sid \
            icon="│" \
            icon.font="Hack Nerd Font:Regular:11.0" \
            icon.color=0xff666666 \
            icon.padding_left=2 \
            icon.padding_right=2 \
            label.drawing=off \
            background.drawing=off \
            updates=off
    fi

    # Add workspace item
    sketchybar --add item space.$sid left --display="$DISPLAY" \
      --set space.$sid \
        drawing=on \
        background.color=#0b111a \
        background.corner_radius=0 \
        background.drawing=off \
        background.border_color=#0b111a \
        background.border_width=0 \
        background.height=22 \
        icon="$sid" \
        icon.font="Hack Nerd Font:Regular:11.0" \
        icon.color=0xffaaaaaa \
        icon.padding_left=8 \
        icon.padding_right=4 \
        label="" \
        label.drawing=on \
        label.font="sketchybar-app-font:Regular:13.0" \
        label.color=0xffaaaaaa \
        label.padding_left=0 \
        label.padding_right=8 \
        label.y_offset=-1 \
        click_script="aerospace workspace $sid" \
        script="$CONFIG_DIR/plugins/aerospace.sh $sid" \
      --subscribe space.$sid aerospace_workspace_change

    ws_idx=$((ws_idx + 1))
done

##### App-Icons beim Start laden #####
for monitor in $(aerospace list-monitors); do
  for sid in $(aerospace list-workspaces --monitor "$monitor" --empty no); do
    apps=$(aerospace list-windows --workspace "$sid" | awk -F'|' '{gsub(/^ *| *$/, "", $2); print $2}')

    sketchybar --set space.$sid drawing=on

    icon_strip=" "
    if [ "${apps}" != "" ]; then
      while read -r app; do
        icon_strip+=" $($CONFIG_DIR/plugins/icon_map_fn.sh "$app")"
      done <<<"${apps}"
    else
      icon_strip=""
    fi

    sketchybar --set space.$sid label="$icon_strip"
  done
done

##### Front App #####
source "$ITEM_DIR/front_app.sh"

##### Rechte Items #####
sketchybar \
  --add item battery right \
  --set battery \
    update_freq=120 \
    script="$PLUGIN_DIR/battery.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=0 \
  --subscribe battery system_woke power_source_change \
  \
  --add item volume right \
  --set volume \
    script="$PLUGIN_DIR/volume.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=0 \
  --subscribe volume volume_change \
  \
  --add item clock right \
  --set clock \
    update_freq=10 \
    script="$PLUGIN_DIR/clock.sh" \
    icon.font="Hack Nerd Font:Regular:11.0" \
    icon.color=0xffaaaaaa \
    label.color=0xffaaaaaa \
    padding_left=0 \
    padding_right=6

sketchybar --update
